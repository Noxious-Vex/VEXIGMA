<Window x:Class="Vexigma.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEXIGMA - Advanced Cipher Laboratory"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B1118">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- GENERAL TEXT                                          -->
        <!-- ===================================================== -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6F2"/>
        </Style>


        <!-- ===================================================== -->
        <!-- COMBO BOXES                                           -->
        <!-- ===================================================== -->

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="#E7EEF7"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#52677D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>


        <!-- ===================================================== -->
        <!-- BUTTONS                                               -->
        <!-- ===================================================== -->

        <Style TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAF2FC"/>
            <Setter Property="Background" Value="#172331"/>
            <Setter Property="BorderBrush" Value="#3A4A5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>


        <!-- ===================================================== -->
        <!-- PANEL STYLE                                           -->
        <!-- ===================================================== -->

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#101923"/>
            <Setter Property="BorderBrush" Value="#304052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>


        <!-- ===================================================== -->
        <!-- CIPHER TEXT BOX STYLE                                 -->
        <!-- ===================================================== -->

        <Style x:Key="CipherTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#091018"/>
            <Setter Property="Foreground" Value="#D8E4F1"/>
            <Setter Property="BorderBrush" Value="#35485B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>


        <!-- ===================================================== -->
        <!-- KEY ENTRY STYLE                                       -->
        <!-- ===================================================== -->

        <Style x:Key="KeyTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#091018"/>
            <Setter Property="Foreground" Value="#DCE6F2"/>
            <Setter Property="BorderBrush" Value="#35485B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN APPLICATION GRID                                     -->
    <!-- ========================================================= -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#0D151E"
                BorderBrush="#304052"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="V E X I G M A"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#F1F6FC"/>

                    <TextBlock Text="A D V A N C E D   C I P H E R   L A B O R A T O R Y"
                               FontSize="12"
                               Foreground="#A7B8CA"
                               Margin="2,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <TextBlock Text="BUILD THE MACHINE."
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               Foreground="#8DA3BA"
                               FontSize="12"/>

                    <TextBlock Text="DEFINE THE CIPHER."
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               Foreground="#8DA3BA"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="EXPLORE THE POSSIBILITIES."
                               HorizontalAlignment="Right"
                               FontFamily="Consolas"
                               Foreground="#8DA3BA"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT                                          -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- MACHINE CONFIGURATION                             -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorder}"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock Text="MACHINE CONFIGURATION"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,24"/>


                        <!-- CHARACTERS -->

                        <TextBlock Text="Characters"
                                   FontSize="14"
                                   Foreground="#AFC1D4"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="CharacterSetComboBox"
                                  SelectedIndex="0"
                                  Margin="0,0,0,10">

                            <ComboBoxItem Content="LETTERS"/>
                            <ComboBoxItem Content="SENSITIVE LETTERS"/>
                            <ComboBoxItem Content="LETTERS &amp; NUMBERS"/>
                            <ComboBoxItem Content="SENSITIVE LETTERS &amp; NUMBERS"/>
                            <ComboBoxItem Content="ALL CHARACTERS"/>

                        </ComboBox>


                        <!-- CHARACTER PREVIEW -->

                        <Border Background="#091018"
                                BorderBrush="#35485B"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12"
                                Margin="0,0,0,20">

                            <StackPanel>

                                <TextBlock FontFamily="Consolas"
                                           FontSize="13"
                                           Foreground="#DCE6F2"
                                           TextWrapping="Wrap"
                                           LineHeight="22">

                                    <Run Text="ABCDEFGHIJKLMNOPQRSTUVWXYZ"/>
                                    <LineBreak/>

                                    <Run Text="abcdefghijklmnopqrstuvwxyz"/>
                                    <LineBreak/>

                                    <Run Text="0123456789"/>
                                    <LineBreak/>

                                    <Run Text="! @ # $ % ^ &amp; * ( ) _ + - ="/>
                                    <LineBreak/>

                                    <Run Text="[ ] { } \ | ; : ' &quot; , . &lt; &gt; / ? ` ~"/>
                                    <LineBreak/>

                                </TextBlock>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- STRING KEY                                        -->
                        <!-- ================================================= -->

                        <TextBlock Text="String Key"
                                   FontSize="14"
                                   Foreground="#AFC1D4"
                                   Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">

                                <PasswordBox x:Name="StringKeyPasswordBox"
                                             Height="38"
                                             Padding="8,5"
                                             FontFamily="Consolas"
                                             FontSize="14"
                                             Background="#091018"
                                             Foreground="#DCE6F2"
                                             BorderBrush="#35485B"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             Visibility="Visible"/>

                                <TextBox x:Name="VisibleStringKeyTextBox"
                                         Style="{StaticResource KeyTextBox}"
                                         Visibility="Collapsed"/>

                            </Grid>

                            <Button x:Name="ShowKeyButton"
                                    Grid.Column="2"
                                    Content="👁"
                                    Height="38"
                                    Padding="0"
                                    FontSize="15"
                                    ToolTip="Show or hide the string key"/>

                        </Grid>


                        <!-- KEY BUTTONS -->

                        <Grid Margin="0,0,0,7">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="GenerateKeyButton"
                                    Grid.Column="0"
                                    Content="GENERATE KEY"
                                    Height="36"
                                    Padding="4"
                                    FontSize="11"/>

                            <Button x:Name="CopyKeyButton"
                                    Grid.Column="2"
                                    Content="COPY KEY"
                                    Height="36"
                                    Padding="4"
                                    FontSize="11"/>

                        </Grid>


                        <!-- KEY INFORMATION -->

                        <TextBlock Text="Same key = same machine configuration (case-sensitive)"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="#72869A"
                                   Margin="1,0,0,3"/>


                        <!-- ROTORS -->

                        <TextBlock Text="Rotors"
                                   FontSize="14"
                                   Foreground="#AFC1D4"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="RotorCountComboBox"
                                  SelectedIndex="0"
                                  Margin="0,0,0,20">

                            <ComboBoxItem Content="3 Rotors"/>
                            <ComboBoxItem Content="4 Rotors"/>
                            <ComboBoxItem Content="5 Rotors"/>
                            <ComboBoxItem Content="6 Rotors"/>
                            <ComboBoxItem Content="8 Rotors"/>
                            <ComboBoxItem Content="10 Rotors"/>

                        </ComboBox>


                        <!-- STEPPING MODE -->

                        <TextBlock Text="Stepping Mode"
                                   FontSize="14"
                                   Foreground="#AFC1D4"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="SteppingModeComboBox"
                                  SelectedIndex="0"
                                  Margin="0,0,0,25">

                            <ComboBoxItem Content="Standard"/>
                            <ComboBoxItem Content="Sequential"/>

                        </ComboBox>


                        <!-- OUTPUT FORMATTING -->

                        <TextBlock Text="Output Formatting"
                                   FontSize="14"
                                   Foreground="#AFC1D4"
                                   Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Characters Per Group"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#72869A"
                                           Margin="1,0,0,5"/>

                                <ComboBox x:Name="CharactersPerGroupComboBox"
                                          SelectedIndex="4">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Groups Per Line"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#72869A"
                                           Margin="1,0,0,5"/>

                                <ComboBox x:Name="GroupsPerLineComboBox"
                                          SelectedIndex="4">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>

                            </StackPanel>

                        </Grid>


                        <!-- CONFIGURE MACHINE -->

                        <Button x:Name="ConfigureMachineButton"
                                Content="⚙   CONFIGURE MACHINE"
                                Height="50"
                                Background="#175A9E"
                                BorderBrush="#3385D5"
                                FontSize="15"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- ================================================= -->
            <!-- CIPHER WORKSPACE                                  -->
            <!-- ================================================= -->

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorder}"
                    Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="CIPHER WORKSPACE"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>


                    <!-- INPUT -->

                    <Border Grid.Row="1"
                            Style="{StaticResource PanelBorder}"
                            Padding="16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="INPUT"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock Text="  (Plaintext / Ciphertext)"
                                           Foreground="#92A7BC"
                                           FontSize="14"/>

                            </StackPanel>

                            <TextBox x:Name="InputTextBox"
                                     Grid.Row="1"
                                     Style="{StaticResource CipherTextBox}"/>

                        </Grid>

                    </Border>


                    <!-- ACTION BUTTONS -->

                    <Grid Grid.Row="2"
                          Margin="50,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="EncryptButton"
                                Grid.Column="0"
                                Content="🔒   ENCRYPT"
                                Background="#0E513A"
                                BorderBrush="#1BA56F"/>

                        <Button x:Name="DecryptButton"
                                Grid.Column="2"
                                Content="🔓   DECRYPT"
                                Background="#12395F"
                                BorderBrush="#2879BF"/>

                        <Button x:Name="ClearButton"
                                Grid.Column="4"
                                Content="CLEAR"/>

                        <Button x:Name="CopyOutputButton"
                                Grid.Column="6"
                                Content="COPY OUTPUT"/>

                    </Grid>


                    <!-- OUTPUT -->

                    <Border Grid.Row="3"
                            Style="{StaticResource PanelBorder}"
                            Padding="16">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,10">

                                <TextBlock Text="OUTPUT"
                                           FontSize="15"
                                           FontWeight="Bold"/>

                                <TextBlock Text="  (Result)"
                                           Foreground="#92A7BC"
                                           FontSize="14"/>

                            </StackPanel>

                            <TextBox x:Name="OutputTextBox"
                                     Grid.Row="1"
                                     Style="{StaticResource CipherTextBox}"
                                     IsReadOnly="True"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#091018"
                BorderBrush="#304052"
                BorderThickness="0,1,0,0">

            <Grid Margin="25,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Ellipse x:Name="StatusIndicator"
                             Width="10"
                             Height="10"
                             Fill="#49D89B"
                             Margin="0,0,12,0"/>

                    <TextBlock x:Name="StatusText"
                               Text="VEXIGMA READY"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#A9BCD0"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock x:Name="MachineStatusText"
                           Grid.Column="1"
                           Text="3 ROTORS   |   LETTERS"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#8DA3BA"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>